<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Нужен Compose Multiplatform: иначе анимации ограничены 60 Гц на iPhone с ProMotion -->
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>
    <!-- Какие VLESS-клиенты искать на устройстве (canOpenURL) -->
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <string>happ</string>
        <string>v2raytun</string>
        <string>streisand</string>
        <string>hiddify</string>
    </array>
    <!-- Возврат из «Быстрых команд» в приложение: kitconn://done -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key><string>ru.kitconn.vpn.kmp</string>
            <key>CFBundleURLSchemes</key>
            <array><string>kitconn</string></array>
        </dict>
    </array>
</dict>
</plist>
